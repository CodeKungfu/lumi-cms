{
  "name": "@repo/database",
  "version": "0.1.0",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/client.js"
    }
  },
  "scripts": {
    "postinstall": "pnpm db:gen",
    "db:gen": "prisma generate --schema=./prisma/schema.sqlite.prisma",
    "build": "tsup src/client.ts --dts",
    "dev": "tsup src/client.ts --watch",
    "format": "prisma format --schema=./prisma/schema.sqlite.prisma",
    "lint": "eslint . --max-warnings 0",
    "prebuild": "pnpm db:gen",
    "predev": "pnpm db:gen",
    "studio": "prisma studio --schema=./prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/node": "^20",
    "eslint": "^8.57.0",
    "prisma": "^6.19.2",
    "tsup": "^8.0.2",
    "typescript": "5.5.4"
  }
}
